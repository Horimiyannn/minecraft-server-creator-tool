{
  "name": "mc-panel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter ./backend typecheck",
    "test": "pnpm --filter ./backend test",
    "test:e2e": "pnpm --filter ./backend test:e2e",
    "build": "pnpm --filter ./backend build",
    "fallow": "fallow dead-code && fallow dupes",
    "test:fe": "pnpm --filter ./frontend test",
    "typecheck:fe": "pnpm --filter ./frontend typecheck",
    "build:fe": "pnpm --filter ./frontend build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^9.1.0",
    "fallow": "^3.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines"
    ]
  }
}
